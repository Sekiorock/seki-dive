{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "users": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "nickname": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lang": {
          ".validate": "newData.isString() && (newData.val() === '' || newData.val() === 'ja' || newData.val() === 'en')"
        },
        "onboarded": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "wallets": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['balance'])",
        "balance": {
          ".validate": "newData.isNumber() && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.val() === 0) || (data.exists() && newData.val() - data.val() <= 3000 && newData.val() - data.val() >= -10000))"
        },
        "foundingGranted": {
          ".validate": "newData.isBoolean() && (root.child('admins').child(auth.uid).val() === true || !(data.val() === true && newData.val() === false))"
        },
        "rewardDay": {
          ".validate": "newData.isString()"
        },
        "rewardToday": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "ledger": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$tx": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists()) || root.child('admins').child(auth.uid).val() === true)",
          ".validate": "newData.hasChildren(['at', 'type', 'amount', 'balance'])",
          "at": {
            ".validate": "newData.isString()"
          },
          "type": {
            ".validate": "newData.isString() && newData.val().matches(/^(grant|reward|prize|purchase|service|fee|fine|tax)$/)"
          },
          "amount": {
            ".validate": "newData.isNumber() && (root.child('admins').child(auth.uid).val() === true || (newData.val() >= -10000 && newData.val() <= 3000))"
          },
          "balance": {
            ".validate": "newData.isNumber()"
          },
          "gross": {
            ".validate": "newData.isNumber()"
          },
          "tax": {
            ".validate": "newData.isNumber() && newData.val() >= 0"
          }
        }
      }
    },
    "treasury": {
      ".read": "auth != null",
      ".write": "auth != null",
      ".validate": "newData.isNumber() && newData.val() >= 0 && (root.child('admins').child(auth.uid).val() === true || (!data.exists() && newData.val() === 100000) || (data.exists() && newData.val() - data.val() >= -1000 && newData.val() - data.val() <= 2000))"
    },
    "treasuryLog": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$id": {
        ".write": "auth != null && (!data.exists() || root.child('admins').child(auth.uid).val() === true)",
        ".validate": "newData.hasChildren(['at', 'uid', 'amount']) && (newData.child('uid').val() === auth.uid || root.child('admins').child(auth.uid).val() === true)",
        "amount": {
          ".validate": "newData.isNumber()"
        }
      }
    },
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    },
    "notices": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
      ".indexOn": [
        "at"
      ]
    },
    "personalNotices": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
      }
    },
    "presence": {
      "home": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid"
        }
      }
    },
    "rooms": {
      ".read": "auth != null",
      "$room": {
        ".write": "auth != null && $room.matches(/^[0-9]{4}$/) && (!data.exists() || data.child('host').val() === auth.uid || data.child('state').val() === 'done' || now - data.child('createdAt').val() > 7200000)",
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "auth.uid === $uid"
          }
        },
        "attacks": {
          "$a": {
            ".write": "auth != null && !data.exists() && newData.child('from').val() === auth.uid && root.child('rooms').child($room).child('players').child(auth.uid).exists()",
            ".validate": "newData.child('from').val() === auth.uid && (!data.exists())"
          }
        },
        "claims": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !data.exists()",
            ".validate": "newData.val() === true && auth.uid === $uid"
          }
        },
        "result": {
          ".write": "auth != null && !data.exists() && root.child('rooms').child($room).child('players').child(auth.uid).exists()"
        }
      }
    },
    "public": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('admins').child(auth.uid).val() === true"
    }
  }
}
